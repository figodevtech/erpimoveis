{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-codex-pdv/types/**/*.ts",
    ".next-verify-nfe/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/app/(app)/(pages)/dashboard/components/dashboard-clientes",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "alphagaragepb",
    "central",
    "central.figosoftwares.com.br",
    "supabase/functions"
  ]
}
