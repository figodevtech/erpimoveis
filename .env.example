# ===========================================================
# ERPOficina — modelo de ambiente para UM deploy/empresa
# ===========================================================
# Copie para .env.local no desenvolvimento ou cadastre cada chave no Vercel.
# Nunca coloque valores reais neste arquivo versionado.

# Banco Supabase exclusivo da empresa
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Endereço e autenticação do ERP
# Local: http://localhost:3000 (ou a porta utilizada)
# Produção: https://erp.empresa.com.br
APP_URL=
NEXT_PUBLIC_APP_URL=
AUTH_SECRET=
CRON_SECRET=

# Instalação da empresa na Figo Central
# PLATFORM_API_URL permanece apontando para a Central, não para o ERP do cliente.
PLATFORM_API_URL=https://central.figosoftwares.com.br
PLATFORM_INSTALLATION_ID=
PLATFORM_API_SECRET=

# Feature flag do canal Shopee no ERP.
# false = oculto no Marketplace e nas Configurações Gerais; true = visível.
NEXT_PUBLIC_SHOPEE_INTEGRATION_ENABLED=false

# Mercado Livre
# O Client ID e Client Secret pertencem ao aplicativo compartilhado.
# A Redirect URI é exclusiva deste domínio e deve existir no painel do aplicativo.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=https://erp.empresa.com.br/api/integracoes/mercadolivre/callback
MERCADOLIVRE_SITE_ID=MLB
MERCADOLIVRE_STATE_SECRET=

# Focus NFe
FOCUS_NFE_API_TOKEN_HOMOLOGACAO=
FOCUS_NFE_API_TOKEN=

# Telegram funcional deste ERP
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Serviços opcionais
RESEND_API_KEY=
EMAIL_FROM=
API_PLACAS_TOKEN=
PAGARME_API_BASE=
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
STONE_POS_SERIAL=
PACOTEVICIO_RAPIDAPI_KEY=
PACOTEVICIO_RAPIDAPI_HOST=
PACOTEVICIO_CONFIDENCE_LEVEL=

# Não configurar SHOPEE_* neste ERP: essas credenciais pertencem à Central.
# ERP_MONITOR_* pertencem aos Secrets da Edge Function, não ao Vercel do ERP.
