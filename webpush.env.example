# Web Push do chat interno (fase 2)
#
# As tres variaveis sao opcionais: sem elas o chat continua funcionando por
# completo e apenas o Web Push fica desligado. A rota GET /api/chat/push/status
# devolve supported=false e a interface deixa de oferecer a ativacao.
#
# Gere o par de chaves VAPID uma unica vez por instalacao:
#
#   npx web-push generate-vapid-keys
#
# Copie o resultado para o .env / .env.local do projeto. NUNCA versione os
# valores reais e nunca prefixe a chave privada com NEXT_PUBLIC_.

# Chave publica VAPID. Vai para o navegador de proposito.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# SEGREDO. Somente no servidor.
WEB_PUSH_VAPID_PRIVATE_KEY=

# Identificacao do remetente exigida pelo padrao VAPID.
# Use mailto: com um e-mail monitorado ou a URL publica do ERP.
WEB_PUSH_SUBJECT=mailto:suporte@exemplo.com.br
