# URL local ou de uma implantação conectada exclusivamente ao banco Demonstração.
CAPTURE_BASE_URL=http://127.0.0.1:3100

# Use uma conta própria para capturas, com acesso aos módulos desejados.
CAPTURE_EMAIL=capturas@example.invalid
CAPTURE_PASSWORD=troque-esta-senha

# Confirmação obrigatória para executar o seed no projeto Supabase Demonstração.
CAPTURE_SEED_CONFIRM=DEMONSTRACAO

# Opcional: também anonimiza valores monetários nas imagens.
CAPTURE_HIDE_FINANCIAL_VALUES=false

# Opcional: gera imagens longas com todo o conteúdo. O padrão captura somente 1440x900.
CAPTURE_FULL_PAGE=false

# O modo 2x gera 2880x1800 para uso posterior em miniaturas mais nítidas.
CAPTURE_DEVICE_SCALE_FACTOR=1
CAPTURE_SCREENSHOT_SCALE=css
