ERP_DB_GARAGE_PREMIUM=postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres
ERP_DB_JEAN_CAR=postgresql://postgres.PROJECT_REF:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
