# Bot criado no @BotFather. Nunca exponha este valor no navegador.
TELEGRAM_BOT_TOKEN=123456789:substitua-pelo-token-real

# Username sem @, exatamente como criado no BotFather.
TELEGRAM_BOT_USERNAME=figo_ordens_bot

# Segredo aleatório enviado pelo Telegram no cabeçalho de cada webhook.
TELEGRAM_WEBHOOK_SECRET=substitua-por-um-segredo-aleatorio

# Ative somente depois de aplicar a migration e configurar o webhook.
TELEGRAM_NOTIFICATIONS_ENABLED=false

# URL HTTPS pública do ERP, sem barra no final.
APP_URL=https://seu-dominio.com.br

# Protege o endpoint chamado pelo agendador.
CRON_SECRET=substitua-por-outro-segredo-aleatorio
